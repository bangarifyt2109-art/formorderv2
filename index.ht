/* =====================================================
   PAKET & FITUR EXCLUSIVE
===================================================== */

function ubahPaket() {
    const paket = document.querySelector('input[name="paketUndangan"]:checked')?.value || "";
    const box = document.getElementById("exclusiveBox");
    const addonBox = document.getElementById("paidAddonBox");

    if (!box || !addonBox) return;

    if (paket === "Exclusive / Full Fitur") {
        box.style.display = "block";
        addonBox.style.display = "none";

        addonBox.querySelectorAll('input[type="checkbox"]').forEach(cb => cb.checked = false);
        addonBox.querySelectorAll(".feature-detail").forEach(el => {
            el.innerHTML = "";
            el.style.display = "none";
        });

    } else if (paket === "Basic" || paket === "Premium") {
        box.style.display = "none";
        addonBox.style.display = "block";

        box.querySelectorAll('input[type="checkbox"]').forEach(cb => cb.checked = false);
        ["detailLoveStory", "detailInstagram", "detailTurutMengundang", "detailGaleri", "detailVideo", "detailLive", "detailDressCode"].forEach(id => {
            const el = document.getElementById(id);
            if (el) { el.innerHTML = ""; el.style.display = "none"; }
        });

    } else {
        box.style.display = "none";
        addonBox.style.display = "none";
    }

    hitungTotalFiturTambahan();
}

function toggleFiturTambahan(checkbox) {
    const isExclusive = !!checkbox.closest("#exclusiveBox");
    const detailMap = {
        "Love Story": "addonLoveStory",
        "Profil Instagram": "addonInstagram",
        "Turut Mengundang": "addonTurutMengundang",
        "Galeri Foto": "addonGaleri",
        "Video Prewedding": "addonVideo",
        "Live Streaming": "addonLive",
        "Dress Code": "addonDressCode",
        "Rekening Tambahan": isExclusive ? "exclusiveAddonRekeningTambahan" : "addonRekeningTambahan"
    };

    const detail = document.getElementById(detailMap[checkbox.value]);

    if (detail) {
        detail.style.display = checkbox.checked ? "block" : "none";
        if (!checkbox.checked) detail.innerHTML = "";
    }

    if (checkbox.checked && detail) {
        if (checkbox.value === "Rekening Tambahan") {
            const jumlah = 1;
            let html = `
                <div class="feature-description">Rp10.000 / rekening.</div>
                <input type="hidden" id="jumlahRekeningTambahan" value="1">
                <div id="${isExclusive ? "exclusive" : "addon"}RekeningTambahanContainer" class="rekeningTambahanContainer"></div>
                <button type="button" class="btn-tambah btnTambahRekeningTambahan" onclick="tambahRekeningTambahan(this)">+ Tambah Rekening 2</button>
            `;
            detail.innerHTML = html;
            renderRekeningTambahan(jumlah);
            return hitungTotalFiturTambahan();
        }

        if (checkbox.value === "Love Story") {
            detail.innerHTML = `
                <div class="feature-description">Isi setiap bagian kisah cinta sesuai urutan. Anda dapat menambahkan beberapa cerita.</div>
                <div id="addonLoveStoryContainer"></div>
                <button type="button" class="btn-tambah" onclick="tambahAddonLoveStory()">+ Tambah Cerita Love Story</button>
            `;
            addonLoveStoryCounter = 0;
            tambahAddonLoveStory();
        }

        if (checkbox.value === "Profil Instagram") {
            detail.innerHTML = `
                ${input("Instagram Pria", "addonInstagramPria", "Contoh: @nama_pria")}
                ${input("Instagram Wanita", "addonInstagramWanita", "Contoh: @nama_wanita")}
            `;
        }

        if (checkbox.value === "Turut Mengundang") {
            detail.innerHTML = buatFormTurutMengundang("addon");
            tambahPihakTurutMengundang("addon", "laki");
            tambahPihakTurutMengundang("addon", "perempuan");
        }

        if (checkbox.value === "Galeri Foto") {
            detail.innerHTML = `
                ${input("Jumlah Foto Tambahan", "jumlahFotoTambahan", "Contoh: 5")}
                <div class="feature-description">Harga dihitung Rp5.000 / foto per foto.</div>
            `;
        }

        if (checkbox.value === "Video Prewedding") {
            detail.innerHTML = `${input("Link Video Prewedding", "addonLinkVideo", "Masukkan link video")}`;
        }

        if (checkbox.value === "Live Streaming") {
            detail.innerHTML = `${input("Link Live Streaming", "addonLinkLive", "Masukkan link live streaming")}`;
        }

        if (checkbox.value === "Dress Code") {
            detail.innerHTML = `${input("Dress Code", "addonDressCodeValue", "Contoh: Formal / Batik")}`;
        }
    }

    hitungTotalFiturTambahan();
}

function renderRekeningTambahan(jumlah, containerId) {
    const container = containerId
        ? document.getElementById(containerId)
        : document.querySelector('.feature-detail[style*="display: block"] .rekeningTambahanContainer');
    if (!container) return;
    const jumlahAman = Math.max(1, Math.min(10, Number(jumlah) || 1));
    let html = "";
    for (let i = 1; i <= jumlahAman; i++) {
        html += `
            <div class="rekening-box" style="margin-top:10px;padding:12px;border:1px solid #e5e7eb;border-radius:10px;">
                <strong>Rekening Tambahan ${i}</strong>
                ${input("Bank / E-Wallet", "rekeningTambahanBank" + i, "Contoh: BCA / Mandiri / DANA")}
                ${input("Nomor Rekening / E-Wallet", "rekeningTambahanNomor" + i, "Masukkan nomor rekening")}
                ${input("Atas Nama", "rekeningTambahanNama" + i, "Nama pemilik rekening")}
            </div>`;
    }
    container.innerHTML = html;
    updateTombolTambahRekening(container);
}

function tambahRekeningTambahan(button) {
    const detail = button?.closest('.feature-detail');
    const container = detail?.querySelector('.rekeningTambahanContainer');
    if (!container) return;

    const jumlahSaatIni = container.querySelectorAll('.rekening-box').length;
    if (jumlahSaatIni >= 10) return;

    const i = jumlahSaatIni + 1;
    const box = document.createElement('div');
    box.className = 'rekening-box';
    box.style.cssText = 'margin-top:10px;padding:12px;border:1px solid #e5e7eb;border-radius:10px;';
    box.innerHTML = `
        <strong>Rekening Tambahan ${i}</strong>
        ${input("Bank / E-Wallet", "rekeningTambahanBank" + i, "Contoh: BCA / Mandiri / DANA")}
        ${input("Nomor Rekening / E-Wallet", "rekeningTambahanNomor" + i, "Masukkan nomor rekening")}
        ${input("Atas Nama", "rekeningTambahanNama" + i, "Nama pemilik rekening")}
    `;
    container.appendChild(box);
    updateTombolTambahRekening(container);
    hitungTotalFiturTambahan();
    updateNominalPembayaranOtomatis();
    renderRingkasanPesananMsainvitation();
}

function updateTombolTambahRekening(container) {
    const detail = container?.closest('.feature-detail');
    const btn = detail?.querySelector('.btnTambahRekeningTambahan');
    if (!container || !btn) return;
    const jumlah = container.querySelectorAll('.rekening-box').length;
    if (jumlah >= 10) {
        btn.style.display = 'none';
    } else {
        btn.style.display = 'block';
        btn.textContent = '+ Tambah Rekening ' + (jumlah + 1);
    }
}

function hitungTotalFiturTambahan() {
    let totalAddon = 0;

    document.querySelectorAll('#paidAddonBox input[name="fiturTambahanBerbayar"]:checked, #exclusiveBox input[name="fiturTambahanBerbayar"]:checked').forEach(cb => {
        let harga = Number(cb.dataset.harga || 0);

        if (cb.value === "Galeri Foto") {
            let jumlah = parseInt(document.getElementById("jumlahFotoTambahan")?.value || "1", 10);
            if (isNaN(jumlah) || jumlah < 1) jumlah = 1;
            harga *= jumlah;
        }

        if (cb.value === "Rekening Tambahan") {
            const jumlah = Math.max(1, document.querySelectorAll(".rekening-box").length);
            harga *= jumlah;
        }

        totalAddon += harga;
    });

    const paket = document.querySelector('input[name="paketUndangan"]:checked')?.value || "";
    const hargaPaket = {
        "Basic": 55000,
        "Premium": 80000,
        "Exclusive / Full Fitur": 120000
    };

    const base = hargaPaket[paket] || 0;
    const grandTotal = base + totalAddon;

    const addonEl = document.getElementById("paidAddonTotal");
    if (addonEl) {
        addonEl.textContent =
            "Total Fitur Tambahan: Rp" + totalAddon.toLocaleString("id-ID");
    }

    const packageEl = document.getElementById("packageSelectedPrice");
    if (packageEl) {
        if (paket) {
            packageEl.textContent =
                "Harga Paket: Rp" + base.toLocaleString("id-ID");
            packageEl.style.display = "block";
        } else {
            packageEl.style.display = "none";
        }
    }

    const grandEl = document.getElementById("packageGrandTotal");
    if (grandEl) {
        grandEl.textContent =
            "Total Harga: Rp" + grandTotal.toLocaleString("id-ID");
    }
}

function toggleFiturExclusive(checkbox) {
    const detailMap = {
        "Love Story": "detailLoveStory",
        "Profil Instagram": "detailInstagram",
        "Turut Mengundang": "detailTurutMengundang",
        "Galeri Foto Tambahan": "detailGaleri",
        "Video Prewedding": "detailVideo",
        "Live Streaming": "detailLive",
        "Dress Code": "detailDressCode",
        "Rekening Tambahan": "exclusiveAddonRekeningTambahan"
    };

    const detail = document.getElementById(detailMap[checkbox.value]);
    if (!detail) return;

    if (!checkbox.checked) {
        detail.innerHTML = "";
        detail.style.display = "none";
        return;
    }

    detail.style.display = "block";

    if (checkbox.value === "Love Story") {
        detail.innerHTML = `
            <div class="feature-description">Isi setiap bagian kisah cinta sesuai urutan. Anda dapat menambahkan beberapa cerita.</div>
            <div id="loveStoryContainer"></div>
            <button type="button" class="btn-tambah" onclick="tambahLoveStory()">+ Tambah Cerita Love Story</button>
        `;
        tambahLoveStory();
    }

    if (checkbox.value === "Profil Instagram") {
        detail.innerHTML = `
            ${input("Instagram Mempelai Pria", "instagramPria", "Contoh: @namapria")}
            ${input("Instagram Mempelai Wanita", "instagramWanita", "Contoh: @namawanita")}
        `;
    }

    if (checkbox.value === "Turut Mengundang") {
        detail.innerHTML = buatFormTurutMengundang("exclusive");
        tambahPihakTurutMengundang("exclusive", "laki");
        tambahPihakTurutMengundang("exclusive", "perempuan");
    }

    if (checkbox.value === "Galeri Foto Tambahan") {
        detail.innerHTML = `${input("Keterangan Galeri", "keteranganGaleri", "Contoh: Tambahkan 20 foto prewedding / keluarga")}`;
    }

    if (checkbox.value === "Video Prewedding") {
        detail.innerHTML = `${input("Link Video", "linkVideoPrewedding", "Contoh: https://youtube.com/...")}`;
    }

    if (checkbox.value === "Live Streaming") {
        detail.innerHTML = `${input("Link Live Streaming", "linkLiveStreaming", "Contoh: https://youtube.com/live/...")}`;
    }

    if (checkbox.value === "Rekening Tambahan") {
        detail.innerHTML = `
            <div class="feature-description">Rp10.000 / rekening.</div>
            <input type="hidden" id="jumlahRekeningTambahanExclusive" value="1">
            <div id="exclusiveRekeningTambahanContainer" class="rekeningTambahanContainer"></div>
            <button type="button" class="btn-tambah btnTambahRekeningTambahan" onclick="tambahRekeningTambahan(this)">+ Tambah Rekening 2</button>
        `;
        renderRekeningTambahan(1, "exclusiveRekeningTambahanContainer");
        hitungTotalFiturTambahan();
        updateNominalPembayaranOtomatis();
    }

    if (checkbox.value === "Dress Code") {
        detail.innerHTML = `${textarea("Informasi Dress Code", "dressCode", "Contoh: Pria memakai kemeja putih, wanita memakai warna pastel...")}`;
    }
}

let jumlahLoveStory = 0;
let jumlahTurutMengundang = 0;

function tambahLoveStory() {
    jumlahLoveStory++;
    const container = document.getElementById("loveStoryContainer");
    if (!container) return;

    const box = document.createElement("div");
    box.className = "acara-box";
    box.id = "love-story-" + jumlahLoveStory;
    box.innerHTML = `
        <div class="acara-header">
            <strong>Kisah ${jumlahLoveStory}</strong>
            <button type="button" class="btn-hapus" onclick="hapusLoveStory('${box.id}')">Hapus</button>
        </div>
        ${input("Judul / Tahapan", "loveJudul" + jumlahLoveStory, "Contoh: Awal Bertemu")}
        ${input("Tanggal / Periode", "loveTanggal" + jumlahLoveStory, "Contoh: Mei 2024")}
        ${textarea("Cerita", "loveCerita" + jumlahLoveStory, "Ceritakan kisah pada tahap ini...")}
    `;
    container.appendChild(box);
}

function hapusLoveStory(id) {
    document.getElementById(id)?.remove();
}

function buatFormTurutMengundang(prefix) {
    return `
        <div class="feature-description">
            <strong>Susunan Turut Mengundang</strong><br>
            Tulis satu nama pada setiap baris. Tekan Enter untuk membuat nama berikutnya.
        </div>

        <div class="section-title" style="margin-top:18px;">Pihak Laki-Laki</div>
        <textarea id="${prefix}TurutLaki"
            placeholder="Contoh:&#10;Bpk. Ahmad&#10;Ibu. Siti"
            style="min-height:120px;"></textarea>
        <div class="feature-description">
            Satu baris untuk satu nama.
        </div>

        <div class="section-title" style="margin-top:24px;">Pihak Perempuan</div>
        <textarea id="${prefix}TurutPerempuan"
            placeholder="Contoh:&#10;Ibu. Aminah&#10;Bpk. Hendra"
            style="min-height:120px;"></textarea>
        <div class="feature-description">
            Satu baris untuk satu nama.
        </div>

        <div class="section-title" style="margin-top:24px;">Pihak Lainnya</div>
        <div class="feature-description">
            Opsional. Tambahkan kelompok atau pihak khusus seperti saksi nikah, wali, keluarga, dan lainnya.
            Di setiap kolom, tulis satu nama pada setiap baris.
        </div>
        <div id="${prefix}TurutLainContainer"></div>
        <button type="button" class="btn-tambah"
            onclick="tambahPihakTurutMengundang('${prefix}', 'lain')">
            + Tambah Pihak Lainnya
        </button>
    `;
}

function tambahPihakTurutMengundang(prefix, kategori) {
    if (kategori !== "lain") return;

    jumlahTurutMengundang++;

    const container = document.getElementById(prefix + "TurutLainContainer");
    if (!container) return;

    const box = document.createElement("div");
    box.className = "acara-box";
    box.id = prefix + "-turut-lain-" + jumlahTurutMengundang;

    box.innerHTML = `
        <div class="acara-header">
            <strong>Pihak Lainnya</strong>
            <button type="button" class="btn-hapus"
                onclick="this.closest('.acara-box').remove()">
                Hapus
            </button>
        </div>

        ${input(
            "Judul / Keterangan Pihak",
            prefix + "TurutLainJudul_" + jumlahTurutMengundang,
            "Contoh: Saksi Nikah"
        )}

        <label>Daftar Nama</label>
        <textarea id="${prefix}TurutLainNama_${jumlahTurutMengundang}"
            placeholder="Contoh:&#10;Bpk. Ahmad&#10;Ibu. Siti"
            style="min-height:120px;"></textarea>

        <div class="feature-description">
            Tulis satu nama pada setiap baris.
        </div>
    `;

    container.appendChild(box);
}

function pecahDaftarBaris(nilai) {
    return (nilai || "")
        .split(/\r?\n/)
        .map(item => item.trim())
        .filter(Boolean);
}

function ambilDataTurutMengundang(prefix) {
    const hasil = {
        laki: pecahDaftarBaris(document.getElementById(prefix + "TurutLaki")?.value),
        perempuan: pecahDaftarBaris(document.getElementById(prefix + "TurutPerempuan")?.value),
        lain: []
    };

    document.querySelectorAll("#" + prefix + "TurutLainContainer .acara-box").forEach(box => {
        const judulInput = box.querySelector('input[id^="' + prefix + 'TurutLainJudul_"]');
        const namaTextarea = box.querySelector('textarea[id^="' + prefix + 'TurutLainNama_"]');
        const daftar = pecahDaftarBaris(namaTextarea?.value);

        if (daftar.length) {
            hasil.lain.push({
                judul: judulInput?.value.trim() || "Pihak Lainnya",
                nama: daftar
            });
        }
    });

    return hasil;
}

function formatPesanTurutMengundang(data, indent = "   ") {
    let hasil = "";

    const tambahBagian = (judul, daftar) => {
        if (daftar && daftar.length) {
            hasil += indent + judul + ":\n";
            daftar.forEach((nama, index) => {
                hasil += indent + (index + 1) + ". " + nama + "\n";
            });
        }
    };

    tambahBagian("Pihak Laki-Laki", data?.laki || []);
    tambahBagian("Pihak Perempuan", data?.perempuan || []);

    (data?.lain || []).forEach((bagian) => {
        tambahBagian(bagian.judul || "Pihak Lainnya", bagian.nama || []);
    });

    return hasil || indent + "-\n";
}

function ambilFiturExclusive() {
    const paket = document.querySelector('input[name="paketUndangan"]:checked')?.value || "-";
    const data = { paket, fitur: [] };

    if (paket !== "Exclusive / Full Fitur") return data;

    document.querySelectorAll('#exclusiveBox input[type="checkbox"]:checked').forEach(cb => {
        const item = { nama: cb.value };

        if (cb.value === "Love Story") {
            item.data = [];
            document.querySelectorAll('#loveStoryContainer .acara-box').forEach(box => {
                const judul = box.querySelector('input[id^="loveJudul"]');
                const tanggal = box.querySelector('input[id^="loveTanggal"]');
                const cerita = box.querySelector('textarea[id^="loveCerita"]');
                item.data.push({
                    judul: judul?.value.trim() || "-",
                    tanggal: tanggal?.value.trim() || "-",
                    cerita: cerita?.value.trim() || "-"
                });
            });
        }

        if (cb.value === "Profil Instagram") {
            item.data = { pria: getValue("instagramPria"), wanita: getValue("instagramWanita") };
        }

        if (cb.value === "Turut Mengundang") {
            item.data = ambilDataTurutMengundang("exclusive");
        }

        if (cb.value === "Galeri Foto Tambahan") item.data = getValue("keteranganGaleri");
        if (cb.value === "Video Prewedding") item.data = getValue("linkVideoPrewedding");
        if (cb.value === "Live Streaming") item.data = getValue("linkLiveStreaming");
        if (cb.value === "Dress Code") item.data = getValue("dressCode");

        data.fitur.push(item);
    });

    return data;
}


let addonLoveStoryCounter = 0;

function tambahAddonLoveStory(data = {}) {
    const container = document.getElementById("addonLoveStoryContainer");
    if (!container) return;

    addonLoveStoryCounter++;

    const box = document.createElement("div");
    box.className = "acara-box";
    box.style.cssText = "margin-top:10px;padding:12px;border:1px solid #e5e7eb;border-radius:10px;";

    box.innerHTML = `
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
            <strong>Cerita ${addonLoveStoryCounter}</strong>
            <button type="button"
                onclick="this.closest('.acara-box').remove()"
                style="border:0;background:#fee2e2;color:#b91c1c;border-radius:6px;padding:5px 8px;cursor:pointer;">
                Hapus
            </button>
        </div>

        <input
            type="text"
            name="addonLoveStoryJudul[]"
            placeholder="Judul cerita, contoh: Awal Bertemu"
            value="${(data.judul || "").replace(/"/g, '&quot;')}"
            style="width:100%;margin-bottom:8px;"
        >

        <input
            type="text"
            name="addonLoveStoryTanggal[]"
            placeholder="Tanggal / waktu, contoh: Mei 2024"
            value="${(data.tanggal || "").replace(/"/g, '&quot;')}"
            style="width:100%;margin-bottom:8px;"
        >

        <textarea
            name="addonLoveStoryCerita[]"
            placeholder="Tulis cerita di sini..."
            rows="4"
            style="width:100%;"
        >${data.cerita || ""}</textarea>
    `;

    container.appendChild(box);
}

function ambilAddonLoveStory() {
    const data = [];

    document.querySelectorAll("#addonLoveStoryContainer .acara-box").forEach(box => {
        const judul = box.querySelector('[name="addonLoveStoryJudul[]"]')?.value.trim() || "-";
        const tanggal = box.querySelector('[name="addonLoveStoryTanggal[]"]')?.value.trim() || "-";
        const cerita = box.querySelector('[name="addonLoveStoryCerita[]"]')?.value.trim() || "-";

        data.push({ judul, tanggal, cerita });
    });

    return data;
}


document.addEventListener("change", function(e) {
    if (!e.target.matches('#paidAddonBox input[name="fiturTambahanBerbayar"]')) return;

    if (e.target.value === "Love Story") {
        const detail = document.getElementById("addonLoveStory");
        if (detail) detail.style.display = e.target.checked ? "block" : "none";

        if (e.target.checked) {
            const container = document.getElementById("addonLoveStoryContainer");
            if (container && container.children.length === 0) {
                tambahAddonLoveStory();
            }
        }
    }
});

function ambilFiturTambahanBerbayar() {
    const paket = document.querySelector('input[name="paketUndangan"]:checked')?.value || "-";
    const data = { fitur: [], total: 0 };

    if (paket !== "Basic" && paket !== "Premium") return data;

    document.querySelectorAll('#paidAddonBox input[name="fiturTambahanBerbayar"]:checked, #exclusiveBox input[name="fiturTambahanBerbayar"]:checked').forEach(cb => {
        let harga = Number(cb.dataset.harga || 0);
        let jumlah = 1;

        if (cb.value === "Galeri Foto") {
            jumlah = parseInt(document.getElementById("jumlahFotoTambahan")?.value || "1", 10);
            if (isNaN(jumlah) || jumlah < 1) jumlah = 1;
            harga *= jumlah;
        }

        const item = { nama: cb.value, harga, jumlah };

        if (cb.value === "Love Story") {
            item.data = ambilAddonLoveStory();
        } else if (cb.value === "Profil Instagram") {
            item.data = {
                pria: getValue("addonInstagramPria"),
                wanita: getValue("addonInstagramWanita")
            };
        } else if (cb.value === "Turut Mengundang") {
            item.data = ambilDataTurutMengundang("addon");
        } else if (cb.value === "Galeri Foto") {
            item.data = jumlah + " foto";
        } else if (cb.value === "Video Prewedding") {
            item.data = getValue("addonLinkVideo");
        } else if (cb.value === "Live Streaming") {
            item.data = getValue("addonLinkLive");
        } else if (cb.value === "Dress Code") {
            item.data = getValue("addonDressCodeValue");
        } else if (cb.value === "Rekening Tambahan") {
            const jumlah = Math.max(1, document.querySelectorAll(".rekening-box").length);
            item.jumlah = jumlah;
            item.harga = jumlah * 10000;
            item.data = [];
            for (let i = 1; i <= jumlah; i++) {
                item.data.push({
                    bank: getValue("rekeningTambahanBank" + i),
                    nomor: getValue("rekeningTambahanNomor" + i),
                    atasNama: getValue("rekeningTambahanNama" + i)
                });
            }
        }

        data.fitur.push(item);
        data.total += harga;
    });

    return data;
}

document.addEventListener("input", function(e) {
    if (e.target && e.target.id === "jumlahFotoTambahan") {
        hitungTotalFiturTambahan();
    }
});

/* =====================================================
   AGAMA → PROSESI
===================================================== */

function ubahAgama() {

    const agama =
        document.getElementById("agama").value;

    const box =
        document.getElementById("boxProsesi");


    if (!agama) {

        box.innerHTML = "";

        return;

    }


    let prosesiDefault = "";


    if (agama === "Islam") {

        prosesiDefault = "Akad Nikah";

    }

    else if (
        agama === "Kristen" ||
        agama === "Katolik"
    ) {

        prosesiDefault = "Pemberkatan";

    }


    box.innerHTML = `

        <div class="form-group">

            <label>
                Jenis Prosesi
            </label>

            <select
                id="jenisProsesi"
                onchange="tampilkanProsesi()"
            >

                <option value="">
                    -- Pilih Prosesi --
                </option>

                <option
                    value="Akad Nikah"
                    ${prosesiDefault === "Akad Nikah" ? "selected" : ""}
                >
                    Akad Nikah
                </option>

                <option
                    value="Pemberkatan"
                    ${prosesiDefault === "Pemberkatan" ? "selected" : ""}
                >
                    Pemberkatan
                </option>

                <option value="Upacara Keagamaan">
                    Upacara Keagamaan
                </option>

                <option value="Prosesi Lainnya">
                    Prosesi Lainnya
                </option>

                <option value="Tidak Ada">
                    Tidak Ada / Lewati
                </option>

            </select>

        </div>

        <div id="detailProsesi"></div>

    `;


    tampilkanProsesi();

}


/* =====================================================
   DETAIL PROSESI
===================================================== */

function tampilkanProsesi() {

    const jenis =
        document.getElementById("jenisProsesi")?.value;

    const box =
        document.getElementById("detailProsesi");


    if (!box) return;


    if (
        !jenis ||
        jenis === "Tidak Ada"
    ) {

        box.innerHTML = "";

        return;

    }


    let labelJenis = jenis;


    if (jenis === "Akad Nikah") {

        labelJenis = "Akad Nikah";

    }

    else if (jenis === "Pemberkatan") {

        labelJenis = "Pemberkatan";

    }


    box.innerHTML = `

        <div class="row">

            ${tanggal(
                "Tanggal " + labelJenis,
                "tanggalProsesi"
            )}

            ${input(
                "Waktu " + labelJenis,
                "waktuProsesi",
                "Contoh: 09.00 WIB"
            )}

        </div>

        ${input(
            "Lokasi " + labelJenis,
            "lokasiProsesi",
            "Nama tempat"
        )}

        ${textarea(
            "Alamat " + labelJenis,
            "alamatProsesi",
            "Alamat lengkap"
        )}

        ${input(
            "Link Google Maps",
            "mapsProsesi",
            "https://maps.google.com/..."
        )}

    `;

}


