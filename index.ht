            Lamaran
        </div>

        <div
            class="kategori-item"
            onclick="pilihKategori('Tunangan', this)"
        >
            <span class="kategori-icon">💎</span>
            Tunangan
        </div>

        <div
            class="kategori-item"
            onclick="pilihKategori('Khitanan', this)"
        >
            <span class="kategori-icon">✨</span>
            Khitanan
        </div>

        <div
            class="kategori-item"
            onclick="pilihKategori('Aqiqah', this)"
        >
            <span class="kategori-icon">👶</span>
            Aqiqah
        </div>

        <div
            class="kategori-item"
            onclick="pilihKategori('Ulang Tahun', this)"
        >
            <span class="kategori-icon">🎂</span>
            Ulang Tahun
        </div>

        <div
            class="kategori-item"
            onclick="pilihKategori('Party & Dinner', this)"
        >
            <span class="kategori-icon">🥂</span>
            Party & Dinner
        </div>

        <div
            class="kategori-item"
            onclick="pilihKategori('Grand Opening', this)"
        >
            <span class="kategori-icon">🎉</span>
            Grand Opening
        </div>

        <div
            class="kategori-item"
            onclick="pilihKategori('Purnabakti', this)"
        >
            <span class="kategori-icon">🏆</span>
            Purnabakti
        </div>

        <div
            class="kategori-item"
            onclick="pilihKategori('Lainnya', this)"
        >
            <span class="kategori-icon">📋</span>
            Lainnya
        </div>

    </div>

</div>


<!-- ================================
     FORM
================================ -->

<div class="card">

    <div class="card-title">
        2. Isi Data Pesanan
    </div>

    <div class="selected-category">

        Kategori :
        <strong id="kategoriTerpilih">
            Belum dipilih
        </strong>

    </div>

    <div id="formDinamis">

        <div class="empty-form">
            Silakan pilih kategori acara terlebih dahulu.
        </div>

    </div>

</div>


<!-- ================================
     WHATSAPP
================================ -->

<div class="card">

    <div class="card-title">
        3. Kirim Pesanan
    </div>

    <div class="info">

        Pastikan semua data yang diisi sudah benar.
        Setelah tombol ditekan, data akan otomatis
        dibuka di WhatsApp admin.

    </div>

    <button
        class="btn-wa"
        onclick="kirimWhatsApp()"
    >
        💬 Kirim Pesanan via WhatsApp
    </button>

</div>


<div class="footer">
    © 2026 MSA Invitation
</div>


</div>



<script>
function tampilkanHari(inputId, outputId) {
    const input = document.getElementById(inputId);
    const output = document.getElementById(outputId);
    if (!input || !output) return;

    if (!input.value) {
        output.textContent = "";
        output.style.display = "none";
        return;
    }

    const date = new Date(input.value + "T00:00:00");
    output.textContent = "Hari: " + date.toLocaleDateString("id-ID", {
        weekday: "long"
    });
    output.style.display = "block";
}

function pasangAutoHari() {
    document.querySelectorAll('input[type="date"]').forEach(input => {
        if (input.dataset.hariTerpasang) return;

        const output = document.createElement("div");
        output.className = "auto-hari";
        output.style.cssText =
            "margin-top:6px;padding:8px 10px;" +
            "background:#f8f9fa;border:1px solid #e5e7eb;" +
            "border-radius:8px;font-size:13px;color:#555;" +
            "display:none;";
        input.insertAdjacentElement("afterend", output);

        const update = () => {
            if (!input.value) {
                output.textContent = "";
                output.style.display = "none";
                return;
            }
            const date = new Date(input.value + "T00:00:00");
            output.textContent = "Hari: " + date.toLocaleDateString("id-ID", {
                weekday: "long"
            });
            output.style.display = "block";
        };

        input.addEventListener("change", update);
        input.addEventListener("input", update);
        input.dataset.hariTerpasang = "true";
        update();
    });
}



/* =====================================================
   NOMOR WHATSAPP ADMIN
   GANTI NOMOR DI BAWAH
===================================================== */

const NOMOR_ADMIN = "6281261233730";


let kategoriDipilih = "";

let jumlahAcara = 0;

let jumlahRekening = 0;


/* =====================================================
   FUNGSI INPUT
===================================================== */

function input(label, id, placeholder = "") {

    return `

        <div class="form-group">

            <label>
                ${label}
            </label>

            <input
                type="text"
                id="${id}"
                placeholder="${placeholder}"
            >

        </div>

    `;

}


function textarea(label, id, placeholder = "") {

    return `

        <div class="form-group">

            <label>
                ${label}
            </label>

            <textarea
                id="${id}"
                placeholder="${placeholder}"
            ></textarea>

        </div>

    `;

}


function tanggal(label, id) {

    return `

        <div class="form-group">

            <label>
                ${label}
            </label>

            <input
                type="date"
                id="${id}"
            >

        </div>

    `;

}


/* =====================================================
   TEMA DARI KATALOG
===================================================== */

let temaDariKatalog = "";
let kategoriDariKatalog = "";

function ambilParameterKatalog() {
    const params = new URLSearchParams(window.location.search);
    temaDariKatalog = (params.get("tema") || "").trim();
    kategoriDariKatalog = (params.get("kategori") || "").trim();
}

function isiTemaDariKatalog() {
    const inputTema = document.getElementById("tema");
    if (!inputTema || !temaDariKatalog) return;
    inputTema.value = temaDariKatalog;
    inputTema.readOnly = true;
    inputTema.style.background = "#f3f4f6";
    const info = document.getElementById("temaOtomatisInfo");
    if (info) info.style.display = "block";
}

function pilihKategoriDariURL() {
    if (!kategoriDariKatalog) return false;
    const item = Array.from(document.querySelectorAll(".kategori-item"))
        .find(el => el.textContent.trim().replace(/\s+/g, " ").includes(kategoriDariKatalog));
    if (!item) return false;
    pilihKategori(kategoriDariKatalog, item);
    return true;
}

/* =====================================================
   PILIH KATEGORI
===================================================== */

function pilihKategori(kategori, element) {

    kategoriDipilih = kategori;

    document
        .querySelectorAll(".kategori-item")
        .forEach(item => {

            item.classList.remove("active");

        });


    element.classList.add("active");


    document
        .getElementById("kategoriTerpilih")
        .textContent = kategori;


    jumlahAcara = 0;

    jumlahRekening = 0;
    jumlahLoveStory = 0;
    jumlahTurutMengundang = 0;


    buatForm(kategori);
    isiTemaDariKatalog();

}


/* =====================================================
   BUAT FORM
===================================================== */

function buatForm(kategori) {

    let html = "";


    /* DATA PEMESAN */

    html += `

        <div id="temaDariKatalogBox" style="margin-bottom:18px;padding:14px 16px;border:1px solid #e5e7eb;border-radius:14px;background:#fafafa;">
            <div style="font-weight:700;margin-bottom:7px;">🎨 Tema Undangan</div>
            <div style="font-size:13px;color:#666;margin-bottom:8px;">Tema yang dipilih dari katalog akan otomatis masuk ke sini.</div>
            <input type="text" id="tema" placeholder="Contoh: Art Blue Java / link tema" style="width:100%;box-sizing:border-box;">
            <div id="temaOtomatisInfo" style="display:none;margin-top:7px;font-size:12px;color:#16803c;">✓ Tema dipilih otomatis dari katalog</div>
        </div>

        <div class="section-title">
            Paket Undangan
        </div>

        <div class="package-note">
            <strong>💡 Pilih Paket Undangan</strong><br>
            Silakan pilih paket yang sesuai dengan kebutuhan Anda.
            Fitur tambahan berbayar dapat dipilih untuk <strong>Paket Basic dan Premium</strong>.
        </div>

        <div class="package-grid-msainvitation">
<label class="package-option">
            <input
                type="radio"
                name="paketUndangan"
                value="Basic"
                onchange="ubahPaket()"
            >
            <strong>Basic — Rp55.000</strong><br><small>Tanpa Foto</small>
        </label>

        <label class="package-option">
            <input
                type="radio"
                name="paketUndangan"
                value="Premium"
                onchange="ubahPaket()"
            >
            <strong>Premium — Rp80.000</strong><br><small>Pakai Foto</small>
        </label>

        <label class="package-option exclusive">
            <input
                type="radio"
                name="paketUndangan"
                value="Exclusive / Full Fitur"
                onchange="ubahPaket()"
            >
            <strong>✨ Exclusive / Full Fitur — Rp120.000<br><small>Semua fitur premium sudah tersedia dalam satu paket</small></strong>
        </label>
</div>


        
<img class="package-poster-msainvitation" src="data:image/jpeg;base64," alt="Paket Undangan MSA Invitation">
<div id="packageSelectedPrice" style="
            margin:12px 0 16px;
            padding:12px 14px;
            border-radius:12px;
            background:#fafafa;
            border:1px solid #e5e7eb;
            font-size:14px;
            font-weight:700;
            display:none;
        ">
            Harga Paket: Rp0
        </div>

        <div id="exclusiveBox" class="exclusive-box">
            <div class="exclusive-title">✨ Fitur Exclusive</div>
            <div class="feature-description">
                Pilih fitur tambahan yang ingin digunakan. Fitur di bawah ini hanya dapat dipilih setelah mengambil Paket Exclusive / Full Fitur.
            </div>

            <label class="feature-check">
                <input type="checkbox" value="Love Story" onchange="toggleFiturExclusive(this)">
                <span>💕 <strong>Love Story / Kisah Cinta</strong><br><small>Tambahkan perjalanan kisah cinta dalam bentuk timeline.</small></span>
            </label>
            <div id="detailLoveStory" class="feature-detail"></div>

            <label class="feature-check">
                <input type="checkbox" value="Profil Instagram" onchange="toggleFiturExclusive(this)">
                <span>📱 <strong>Profil Instagram Mempelai</strong><br><small>Tambahkan akun Instagram mempelai.</small></span>
            </label>
            <div id="detailInstagram" class="feature-detail"></div>

            <label class="feature-check">
                <input type="checkbox" value="Turut Mengundang" onchange="toggleFiturExclusive(this)">
