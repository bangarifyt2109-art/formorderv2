/* =====================================================
   KIRIM WHATSAPP
===================================================== */


/* =========================================================
   TOTAL PEMBAYARAN OTOMATIS + KODE UNIK
   ========================================================= */
let kodeUnikPembayaran = null;

function rupiahOtomatis(n) {
    return "Rp" + Number(n || 0).toLocaleString("id-ID");
}

function ambilHargaPaketOtomatis() {
    const paket = document.querySelector('input[name="paketUndangan"]:checked');
    if (!paket) return 0;

    const hargaMap = {
        "Basic": 55000,
        "Premium": 80000,
        "Exclusive / Full Fitur": 120000,
        "Full Fitur": 120000
    };

    return hargaMap[paket.value] || 0;
}

function ambilHargaFiturTambahanOtomatis() {
    let total = 0;

    document.querySelectorAll('input[name="fiturTambahanBerbayar"]:checked').forEach(cb => {
        const harga = Number(cb.dataset.harga || 0);
        total += harga;
    });

    // Galeri Foto: Rp5.000 per foto
    // Form saat ini menggunakan jumlahFotoTambahan.
    // Selector lama tetap didukung agar fungsi lain tidak berubah.
    const galeri = document.querySelector('input[name="fiturTambahanBerbayar"][value="Galeri Foto"]');
    if (galeri?.checked) {
        const field = document.querySelector(
            '#jumlahFotoTambahan, input[name="jumlahFotoTambahan"], #jumlahGaleriTambahan, input[name="jumlahGaleriTambahan"]'
        );
        const jumlah = Math.max(1, Number(field?.value || 1));
        total -= Number(galeri.dataset.harga || 5000);
        total += jumlah * 5000;
    }

    // Rekening tambahan: Rp10.000 / rekening
    const rekening = document.querySelector(
        'input[name="fiturTambahanBerbayar"][value*="Rekening"]:checked, input[name="fiturTambahanBerbayar"][value*="rekening"]:checked'
    );
    if (rekening?.checked) {
        // Jumlah rekening mengikuti jumlah box rekening yang benar-benar ditambahkan.
        // Rekening 1 = Rp10.000, setiap rekening berikutnya menambah Rp10.000.
        const jumlahBox = document.querySelectorAll('.rekening-box').length;
        const field = document.querySelector(
            '#jumlahRekeningTambahan, input[name="jumlahRekeningTambahan"]'
        );
        const jumlah = jumlahBox > 0
            ? jumlahBox
            : Math.max(1, Number(field?.value || 1));
        total -= Number(rekening.dataset.harga || 10000);
        total += jumlah * 10000;
    }

    return total;
}

function buatKodeUnikPembayaran() {
    if (kodeUnikPembayaran !== null) return kodeUnikPembayaran;

    // 3 digit, 001-999. Dibuat sekali selama order/form ini dibuka.
    kodeUnikPembayaran = Math.floor(Math.random() * 999) + 1;
    return kodeUnikPembayaran;
}


function formatRupiahPembayaran(n) {
    return "Rp" + Number(n || 0).toLocaleString("id-ID");
}

async function salinNominalPembayaran() {
    const hasil = updateNominalPembayaranOtomatis();
    const nominal = String(hasil.totalBayar);

    try {
        await navigator.clipboard.writeText(nominal);

        const btn = document.getElementById("btnSalinNominal");
        if (btn) {
            const teksAwal = btn.innerHTML;
            btn.innerHTML = "✓ Nominal Tersalin";
            setTimeout(() => {
                btn.innerHTML = teksAwal;
            }, 1800);
        }
    } catch (err) {
        // Fallback untuk browser yang tidak mengizinkan navigator.clipboard.
        const input = document.createElement("input");
        input.value = nominal;
        document.body.appendChild(input);
        input.select();
        document.execCommand("copy");
        input.remove();

        const btn = document.getElementById("btnSalinNominal");
        if (btn) {
            const teksAwal = btn.innerHTML;
            btn.innerHTML = "✓ Nominal Tersalin";
            setTimeout(() => {
                btn.innerHTML = teksAwal;
            }, 1800);
        }
    }
}

function updateNominalPembayaranOtomatis() {
    const totalHarga = ambilHargaPaketOtomatis() + ambilHargaFiturTambahanOtomatis();
    const kode = buatKodeUnikPembayaran();
    const totalBayar = totalHarga + kode;

    const totalEl = document.getElementById("totalHargaOtomatis");
    const kodeEl = document.getElementById("kodeUnikOtomatis");
    const bayarEl = document.getElementById("totalPembayaranOtomatis");

    if (totalEl) totalEl.textContent = formatRupiahPembayaran(totalHarga);
    if (kodeEl) kodeEl.textContent = String(kode).padStart(3, "0");
    if (bayarEl) bayarEl.textContent = formatRupiahPembayaran(totalBayar);

    const nominalInputs = [
        document.getElementById("nominalPembayaran"),
        document.getElementById("nominal"),
        document.querySelector('input[name="nominalPembayaran"]')
    ].filter(Boolean);

    nominalInputs.forEach(input => {
        input.value = totalBayar;
        input.setAttribute("readonly", "readonly");
    });

    // Simpan untuk dipakai ketika membuat pesan WhatsApp.
    window.totalHargaOtomatis = totalHarga;
    window.kodeUnikPembayaran = kode;
    window.totalPembayaranOtomatis = totalBayar;

    return { totalHarga, kode, totalBayar };
}

document.addEventListener("change", function(e) {
    if (
        e.target.matches('input[name="paketUndangan"]') ||
        e.target.matches('input[name="fiturTambahanBerbayar"]') ||
        e.target.matches('#jumlahFotoTambahan, input[name="jumlahFotoTambahan"]') ||
        e.target.matches('#jumlahGaleriTambahan, input[name="jumlahGaleriTambahan"]')
    ) {
        updateNominalPembayaranOtomatis();
    }
});

document.addEventListener("input", function(e) {
    if (
        e.target.matches('#jumlahFotoTambahan, input[name="jumlahFotoTambahan"]') ||
        e.target.matches('#jumlahGaleriTambahan, input[name="jumlahGaleriTambahan"]')
    ) {
        updateNominalPembayaranOtomatis();
    }
});

document.addEventListener("DOMContentLoaded", function() {
    ambilParameterKatalog();
    pilihKategoriDariURL();
    setTimeout(updateNominalPembayaranOtomatis, 100);
});


function formatRingkasanPembayaranWhatsApp() {
    const p = updateNominalPembayaranOtomatis();
    return [
        "",
        "PEMBAYARAN",
        "Total Harga: " + rupiahOtomatis(p.totalHarga),
        "Kode Unik: " + String(p.kode).padStart(3, "0"),
        "Total Pembayaran: " + rupiahOtomatis(p.totalBayar)
    ].join("\n");
}

function kirimWhatsApp() {

    if (!kategoriDipilih) {

        alert(
            "Silakan pilih kategori acara terlebih dahulu."
        );

        return;

    }


    if (
        getValue("namaPemesan") === "-"
    ) {

        alert(
            "Silakan isi Nama Pemesan."
        );

        return;

    }


    if (
        getValue("noWa") === "-"
    ) {

        alert(
            "Silakan isi Nomor WhatsApp."
        );

        return;

    }


    let pesan = "";


    pesan +=
        "*FORM ORDER UNDANGAN WEBSITE*";

    pesan +=
        "\n━━━━━━━━━━━━━━━━━━━━\n\n";


    pesan +=
        "*KATEGORI ACARA*\n";

    pesan +=
        kategoriDipilih;

    pesan += "\n\n";


    pesan +=
        "*DATA PEMESAN*\n\n";


    pesan +=
        "Nama Pemesan : " +
        getValue(
            "namaPemesan"
        ) +
        "\n";


    pesan +=
        "No. WhatsApp : " +
        getValue(
            "noWa"
        ) +
        "\n";


    pesan +=
        "Tema : " +
        getValue(
            "tema"
        ) +
        "\n\n";

    /* =========================================
       PAKET & FITUR EXCLUSIVE
    ========================================= */
    const fiturExclusive = ambilFiturExclusive();
    pesan += "*PAKET UNDANGAN*\n";
    pesan += "Paket : " + fiturExclusive.paket + "\n";

    const hargaPaket = {
        "Basic": 55000,
        "Premium": 80000,
        "Exclusive / Full Fitur": 120000
    };
    const hargaDasarPaket = hargaPaket[fiturExclusive.paket] || 0;
    pesan += "Harga Paket : Rp" + hargaDasarPaket.toLocaleString("id-ID") + "\n";

    const fiturTambahan = ambilFiturTambahanBerbayar();

    if (fiturTambahan.fitur.length > 0) {
        pesan += "\n*FITUR TAMBAHAN BERBAYAR*\n";

        fiturTambahan.fitur.forEach((fitur, index) => {
            pesan += "\n" + (index + 1) + ". " + fitur.nama +
                " - Rp" + fitur.harga.toLocaleString("id-ID") + "\n";

            if (fitur.data) {
                if (fitur.nama === "Love Story" && Array.isArray(fitur.data)) {
                    fitur.data.forEach((story, storyIndex) => {
                        pesan += "   Kisah " + (storyIndex + 1) + " : " + story.judul + "\n";
                        pesan += "   Tanggal/Periode : " + story.tanggal + "\n";
                        pesan += "   Cerita : " + story.cerita + "\n";
                    });
                } else if (fitur.nama === "Profil Instagram") {
                    pesan += "   Instagram Pria : " + fitur.data.pria + "\n";
                    pesan += "   Instagram Wanita : " + fitur.data.wanita + "\n";
                } else if (fitur.nama === "Turut Mengundang" && fitur.data && !Array.isArray(fitur.data)) {
                    pesan += formatPesanTurutMengundang(fitur.data);
                } else {
                    pesan += "   Detail : " + fitur.data + "\n";
                }
            }
        });

        pesan += "Total Fitur Tambahan : Rp" +
            fiturTambahan.total.toLocaleString("id-ID") + "\n";
    }

    const totalOrder = hargaDasarPaket + fiturTambahan.total;
    pesan += "Total Harga Order : Rp" +
        totalOrder.toLocaleString("id-ID") + "\n";


    if (fiturExclusive.fitur.length > 0) {
        pesan += "\n*FITUR EXCLUSIVE*\n";

        fiturExclusive.fitur.forEach((fitur, index) => {
            pesan += "\n" + (index + 1) + ". " + fitur.nama + "\n";

            if (fitur.nama === "Love Story" && Array.isArray(fitur.data)) {
                fitur.data.forEach((story, storyIndex) => {
                    pesan += "   Kisah " + (storyIndex + 1) + " : " + story.judul + "\n";
                    pesan += "   Tanggal/Periode : " + story.tanggal + "\n";
                    pesan += "   Cerita : " + story.cerita + "\n";
                });
            } else if (fitur.nama === "Profil Instagram") {
                pesan += "   Instagram Pria : " + fitur.data.pria + "\n";
                pesan += "   Instagram Wanita : " + fitur.data.wanita + "\n";
            } else if (fitur.nama === "Turut Mengundang" && fitur.data && !Array.isArray(fitur.data)) {
                pesan += formatPesanTurutMengundang(fitur.data);
            } else if (fitur.data) {
                pesan += "   Detail : " + fitur.data + "\n";
            }
        });
    }

    pesan += "\n";


    pesan +=
        buatDataUtama();


    /* =========================================
       ACARA TAMBAHAN
    ========================================= */

    const acaraTambahan =
        ambilAcaraTambahan();


    if (
        acaraTambahan.length > 0
    ) {

        pesan +=
            "\n\n*ACARA TAMBAHAN*\n";


        acaraTambahan.forEach(
            (acara, index) => {

                pesan +=
                    "\n" +
                    (index + 1) +
                    ". " +
                    acara.nama +
                    "\n";

                pesan +=
                    "Tanggal : " +
                    acara.tanggal +
                    "\n";

                pesan +=
                    "Waktu : " +
                    acara.waktu +
                    "\n";

                pesan +=
                    "Lokasi : " +
                    acara.lokasi +
                    "\n";

                pesan +=
                    "Alamat : " +
                    acara.alamat +
                    "\n";

                pesan +=
                    "Google Maps : " +
                    acara.maps +
                    "\n";

            }
        );

    }


    /* =========================================
       REKENING
    ========================================= */

    const rekening =
        ambilRekening();


    if (
        rekening.length > 0
    ) {

        pesan +=
            "\n*REKENING / E-WALLET*\n";


        rekening.forEach(
            (rek, index) => {

                pesan +=
                    "\n" +
                    (index + 1) +
                    ". " +
                    rek.jenis +
                    "\n";

                pesan +=
                    "Nama : " +
                    rek.nama +
                    "\n";

                pesan +=
                    "Nomor : " +
                    rek.nomor +
                    "\n";

                pesan +=
                    "Atas Nama : " +
                    rek.atasNama +
                    "\n";

            }
        );

    }

/* =========================================
   PEMBAYARAN
========================================= */

const metodePembayaran =
    getValue("metodePembayaran");

if (
    metodePembayaran !== "-"
) {

    pesan +=
        "\n*PEMBAYARAN*\n";


    pesan +=
        "Metode : " +
        metodePembayaran +
        "\n";


    let pembayaranNama = "-";


    if (
        metodePembayaran === "Bank"
    ) {

        pembayaranNama =
            getValue(
                "bankPembayaran"
            );

    }

    else if (
        metodePembayaran === "E-Wallet"
    ) {

        pembayaranNama =
            getValue(
                "ewalletPembayaran"
            );

    }

    else if (
        metodePembayaran === "Shopee"
    ) {

        pembayaranNama =
            "Shopee";

    }

    else if (
        metodePembayaran === "QRIS"
    ) {

        pembayaranNama =
            "QRIS";

    }


    pesan +=
        "Pembayaran : " +
        pembayaranNama +
        "\n";


    const nominal =
        getValue(
            "nominalPembayaran"
        );


    if (
        nominal !== "-"
    ) {

        pesan +=
            "Nominal : Rp " +
            nominal +
            "\n";

    }


    const namaPengirim =
        getValue(
            "namaPengirimPembayaran"
        );


    if (
        namaPengirim !== "-"
    ) {

        pesan +=
            "Nama Pengirim : " +
            namaPengirim +
            "\n";

    }


    const sudahBayar =
        document.getElementById(
            "sudahBayar"
        );


    pesan +=
        "Status : " +
        (
            sudahBayar?.checked
            ?
            "Sudah melakukan pembayaran"
            :
            "Belum melakukan pembayaran"
        ) +
        "\n";


    const bukti =
        document.getElementById(
            "buktiPembayaran"
        );


    pesan +=
        "\n*BUKTI PEMBAYARAN*\n";


    if (
        bukti?.files?.length
    ) {

        pesan +=
            "Bukti sudah dipilih.\n";

        pesan +=
            "Silakan kirim foto bukti pembayaran di chat WhatsApp ini.\n";

    }

    else {

        pesan +=
            "Belum ada bukti pembayaran.\n";

    }

}
    /* =========================================
       KADO
    ========================================= */

    pesan +=
        "\n*KIRIM KADO*\n";

    pesan +=
        getValue(
            "alamatKado"
        ) +
        "\n";


    /* =========================================
       MUSIK
    ========================================= */

    pesan +=
        "\n*MUSIK UNDANGAN*\n";


    const musik =
        document.querySelector(
            'input[name="musik"]:checked'
        );


    if (!musik) {

        pesan +=
            "Belum dipilih\n";

    }

    else if (
        musik.value ===
        "Judul Lagu"
    ) {

        pesan +=
            "Jenis : Judul Lagu\n";

        pesan +=
            "Judul : " +
            getValue(
                "judulLagu"
            ) +
            "\n";

    }

    else if (
        musik.value ===
        "Link YouTube"
    ) {

        pesan +=
            "Jenis : Link YouTube\n";

        pesan +=
            "Link : " +
            getValue(
                "linkYoutube"
            ) +
            "\n";

    }

    else {

        pesan +=
            "Tidak menggunakan musik\n";

    }


    /* =========================================
       CATATAN
    ========================================= */

    pesan +=
        "\n*CATATAN TAMBAHAN*\n";

    pesan +=
        getValue(
            "catatan"
        );


    pesan +=
        "\n\n━━━━━━━━━━━━━━━━━━━━";


    /* =========================================
       OPEN WHATSAPP
    ========================================= */

    const url =
        "https://wa.me/" +
        NOMOR_ADMIN +
        "?text=" +
        encodeURIComponent(
            pesan
        );


    window.open(
        url,
        "_blank"
    );

}


const observerHari = new MutationObserver(() => {
    pasangAutoHari();
});
observerHari.observe(document.body, {
    childList: true,
    subtree: true
});
</script>


<script>
function renderRingkasanPesananMsainvitation() {
    const box = document.getElementById("ringkasanIsiMsainvitation");
    const totalBox = document.getElementById("ringkasanTotalMsainvitation");
    if (!box || !totalBox) return;

    const paket = document.querySelector('input[name="paketUndangan"]:checked');

    const packageNames = {
        "Basic": "Basic",
        "Premium": "Premium",
        "Exclusive / Full Fitur": "Exclusive"
    };

    const packagePrices = {
        "Basic": 55000,
        "Premium": 80000,
        "Exclusive / Full Fitur": 120000
    };

    let total = paket ? (packagePrices[paket.value] || 0) : 0;
    let rows = [];

    if (paket) {
        const hargaPaket = packagePrices[paket.value] || 0;
        rows.push(
            "<div style='display:flex;justify-content:space-between;margin-bottom:6px;gap:10px;'>" +
            "<span>Paket " + (packageNames[paket.value] || paket.value) + "</span>" +
            "<strong>Rp" + hargaPaket.toLocaleString("id-ID") + "</strong></div>"
        );
    }

    const addonInputs = document.querySelectorAll(
        '#paidAddonBox input[name="fiturTambahanBerbayar"]:checked, ' +
        '#exclusiveBox input[name="fiturTambahanBerbayar"]:checked'
    );

    addonInputs.forEach(cb => {
        const harga = Number(cb.dataset.harga || 0);
        let jumlah = 1;

        // Gunakan field jumlah yang memang sudah ada pada form.
        if (cb.value === "Galeri Foto" || cb.value === "Foto Tambahan") {
            const field =
                document.getElementById("jumlahFotoTambahan") ||
                document.querySelector('[name="jumlahFotoTambahan"]');
            if (field) jumlah = Number(field.value || 1);
        }

        if (cb.value === "Rekening Tambahan") {
            const jumlahRekening = document.querySelectorAll(".rekening-box").length;
            jumlah = jumlahRekening > 0 ? jumlahRekening : 1;
        }

        jumlah = Math.max(1, jumlah);
        const subtotal = harga * jumlah;
        total += subtotal;

        const label = cb.value + (jumlah > 1 ? " (" + jumlah + ")" : "");
        rows.push(
            "<div style='display:flex;justify-content:space-between;margin-bottom:6px;gap:10px;'>" +
            "<span>" + label + "</span>" +
            "<strong>Rp" + subtotal.toLocaleString("id-ID") + "</strong></div>"
        );
    });

    box.innerHTML = rows.length
        ? rows.join("")
        : "<div style='font-size:13px;color:#777;'>Belum ada paket atau fitur tambahan yang dipilih.</div>";

    totalBox.textContent = "Rp" + total.toLocaleString("id-ID");

    document.querySelectorAll('input[name="paketUndangan"]').forEach(radio => {
        const card = radio.closest(".package-option");
        if (card) {
            card.classList.toggle("selected-msainvitation", radio.checked);
        }
    });
}

document.addEventListener("change", function(e) {
    if (
        e.target.matches('input[name="paketUndangan"]') ||
        e.target.matches('#paidAddonBox input[name="fiturTambahanBerbayar"]') ||
        e.target.matches('#exclusiveBox input[name="fiturTambahanBerbayar"]')
    ) {
        setTimeout(renderRingkasanPesananMsainvitation, 50);
    }
});

document.addEventListener("input", function(e) {
    if (
        e.target.id === "jumlahFotoTambahan"
    ) {
        setTimeout(renderRingkasanPesananMsainvitation, 50);
    }
});

document.addEventListener("DOMContentLoaded", function() {
    setTimeout(renderRingkasanPesananMsainvitation, 100);
});
</script>

</body>
</html>
